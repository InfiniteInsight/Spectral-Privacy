---
import Logo from "./Logo.astro";
---

<nav>
  <a href="/" class="nav-logo">
    <Logo width={52} />
    <span>spectral</span>
  </a>
  <div class="nav-links">
    <a href="#features">Features</a>
    <a href="#how-it-works">How it works</a>
    <a href="https://github.com/InfiniteInsight/spectral-privacy" target="_blank" rel="noopener">GitHub</a>
  </div>
</nav>

<style>
  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 40px;
    background: rgba(240, 253, 244, 0.72);
    backdrop-filter: blur(16px) saturate(1.6);
    -webkit-backdrop-filter: blur(16px) saturate(1.6);
    border-bottom: 1px solid rgba(209, 250, 229, 0.6);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .nav-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: 'Josefin Sans', sans-serif;
    font-size: 20px;
    font-weight: 700;
    color: var(--green-500);
    letter-spacing: 1px;
  }

  .nav-links {
    display: flex;
    gap: 24px;
    align-items: center;
  }

  .nav-links a {
    font-size: 14px;
    color: var(--gray-700);
    transition: color 0.15s;
  }

  .nav-links a:hover {
    color: var(--green-500);
  }
</style>
